<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Credit_No_Credit_Section_Grade__c</fullName>
    <description>If the selected grade scale is Credit/No Credit and the grade average is above passing threshold then they get Credit.  Otherwise they get No Credit.  If it is a different scale the field is blank.</description>
    <externalId>false</externalId>
    <formula>IF(AND(TEXT(Student_Section__r.Section__r.Course__r.Grade_Scale__c)= &apos;Credit/No Credit&apos;,  Grade__c &gt;= Student_Section__r.Student__r.Setup__r.Passing_Grade_Threshold__c), &apos;C&apos;, IF(AND(TEXT(Student_Section__r.Section__r.Course__r.Grade_Scale__c)= &apos;Credit/No Credit&apos;, NOT(ISBLANK(Grade__c))),&apos;NC&apos;,&apos;&apos;))</formula>
    <label>Credit/No Credit Section Grade</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
