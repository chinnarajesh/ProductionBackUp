<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Average_Section_Grade__c</fullName>
    <formula>IF(Count_Section_Grades__c &gt; 0,(Total_Grade_Value__c / (100*Count_Section_Grades__c)),0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Average Section Grade</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
