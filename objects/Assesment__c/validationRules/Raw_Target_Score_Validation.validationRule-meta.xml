<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Raw_Target_Score_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>or(Raw_Score_Target__c&lt;0,Raw_Score_Target__c&gt;30)</errorConditionFormula>
    <errorDisplayField>Raw_Score_Target__c</errorDisplayField>
    <errorMessage>Raw Score Target must be within the range of 0 - 30</errorMessage>
</ValidationRule>
