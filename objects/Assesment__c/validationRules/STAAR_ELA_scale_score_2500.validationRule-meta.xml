<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>STAAR_ELA_scale_score_2500</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Assessment_Name__c = &quot;STAAR Reading - ELA&quot;, 
OR(Scale_Score__c &lt; 0, 
Scale_Score__c &gt; 2500))</errorConditionFormula>
    <errorDisplayField>Scale_Score__c</errorDisplayField>
    <errorMessage>Scaled Score must be within the range of 0 to 2500.</errorMessage>
</ValidationRule>
