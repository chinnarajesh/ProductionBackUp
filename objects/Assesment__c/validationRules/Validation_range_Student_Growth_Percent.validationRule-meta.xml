<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_range_Student_Growth_Percent</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
 Student_Growth_Percentile__c &lt; 0, 
Student_Growth_Percentile__c &gt; 99 
 )</errorConditionFormula>
    <errorDisplayField>Student_Growth_Percentile__c</errorDisplayField>
    <errorMessage>Student Growth Percentile Equivalent Score must be within a 0 - 99 range.</errorMessage>
</ValidationRule>
