<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Scale_Score</fullName>
    <active>false</active>
    <errorConditionFormula>OR( 
Scale_Score__c &lt; 0, 
Scale_Score__c &gt; 1850 
)</errorConditionFormula>
    <errorDisplayField>Scale_Score__c</errorDisplayField>
    <errorMessage>Scaled Score must be within a 0 - 1850 range.</errorMessage>
</ValidationRule>
