<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_AIMS_ELA_Student</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
      AIMSweb_ELA_Student_Target_Score__c      &lt; 0, 
  AIMSweb_ELA_Student_Target_Score__c       &gt; 400 
 )</errorConditionFormula>
    <errorDisplayField>AIMSweb_ELA_Student_Target_Score__c</errorDisplayField>
    <errorMessage>AIMSweb ELA Student Target Score must be within a 0 - 400 range.</errorMessage>
</ValidationRule>
