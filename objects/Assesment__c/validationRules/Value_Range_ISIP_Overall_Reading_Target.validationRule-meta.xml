<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_ISIP_Overall_Reading_Target</fullName>
    <active>true</active>
    <description>ISIP_Overall_Reading_Ability_Target_Scor__c</description>
    <errorConditionFormula>OR
( 
 ISIP_Overall_Reading_Ability_Target_Scor__c &lt; -5000, 
ISIP_Overall_Reading_Ability_Target_Scor__c &gt; 5000
 )</errorConditionFormula>
    <errorDisplayField>ISIP_Overall_Reading_Ability_Target_Scor__c</errorDisplayField>
    <errorMessage>ISIP Overall Reading Ability Target Score must be within -5000 to 5000 range</errorMessage>
</ValidationRule>
