<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Sum_of_strength_indicators</fullName>
    <active>true</active>
    <description>Sum_of_all_strength_indicators__c</description>
    <errorConditionFormula>OR
( 
 Sum_of_all_strength_indicators__c &lt; 0, 
Sum_of_all_strength_indicators__c &gt; 14
 )</errorConditionFormula>
    <errorDisplayField>Sum_of_all_strength_indicators__c</errorDisplayField>
    <errorMessage>Score must be within 0 to 14 range</errorMessage>
</ValidationRule>
