<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Quantile</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
  Quantile_Score__c   &lt; -2000, 
 Quantile_Score__c  &gt; 2000
 )</errorConditionFormula>
    <errorDisplayField>Quantile_Score__c</errorDisplayField>
    <errorMessage>Quantile Score must be within  - 2000 to 2000 range.</errorMessage>
</ValidationRule>
