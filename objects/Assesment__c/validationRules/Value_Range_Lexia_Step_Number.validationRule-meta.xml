<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Lexia_Step_Number</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
  Lexia_Step_Number_Target_Score__c    &lt; 0, 
  Lexia_Step_Number_Target_Score__c    &gt; 30 
 )</errorConditionFormula>
    <errorDisplayField>Lexia_Step_Number__c</errorDisplayField>
    <errorMessage>Lexia Step Number must be within a 0 - 30 range.</errorMessage>
</ValidationRule>
