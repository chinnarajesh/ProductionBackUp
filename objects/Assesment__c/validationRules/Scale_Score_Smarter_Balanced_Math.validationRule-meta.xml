<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Scale_Score_Smarter_Balanced_Math</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Assessment_Name__c = &quot;Smarter Balanced - MATH&quot;,
OR(Scale_Score__c &lt; 2000,
Scale_Score__c &gt; 3000))</errorConditionFormula>
    <errorDisplayField>Scale_Score__c</errorDisplayField>
    <errorMessage>The Smarter Balanced Assessment Score Range is between 2000 - 3000.</errorMessage>
</ValidationRule>
