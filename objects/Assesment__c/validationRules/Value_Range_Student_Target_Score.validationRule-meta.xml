<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Student_Target_Score</fullName>
    <active>true</active>
    <errorConditionFormula>OR( 
Student_Target_Score__c &lt; 0, 
Student_Target_Score__c &gt; 1850 
)</errorConditionFormula>
    <errorDisplayField>Student_Target_Score__c</errorDisplayField>
    <errorMessage>Student Target Score must be within a 0 - 1850 range.</errorMessage>
</ValidationRule>
