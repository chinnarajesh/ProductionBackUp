<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_DRA_target_score</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
DRA_GLE_Student_Target_Score__c &lt; 0, 
DRA_GLE_Student_Target_Score__c &gt; 80 
 )</errorConditionFormula>
    <errorDisplayField>DRA_GLE_Student_Target_Score__c</errorDisplayField>
    <errorMessage>DRA Grade Level Equivalent Student Target Score must be within a 0 - 80 range.</errorMessage>
</ValidationRule>
