<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_Level_Code</fullName>
    <active>true</active>
    <description>Level_Code__c</description>
    <errorConditionFormula>OR
( 
 Level_Code__c &lt; 1, 
Level_Code__c &gt; 4
 )</errorConditionFormula>
    <errorDisplayField>Level_Code__c</errorDisplayField>
    <errorMessage>Score must be within 1 to 4 range</errorMessage>
</ValidationRule>
