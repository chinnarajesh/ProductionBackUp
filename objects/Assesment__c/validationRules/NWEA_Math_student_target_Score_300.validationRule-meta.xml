<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NWEA_Math_student_target_Score_300</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Assessment_Name__c = &quot;NWEA - MATH&quot;, 
OR( Student_Target_Score__c &lt; 0, 
Student_Target_Score__c &gt; 300))</errorConditionFormula>
    <errorDisplayField>Student_Target_Score__c</errorDisplayField>
    <errorMessage>Student Target Score must be within the range of 0 to 300.</errorMessage>
</ValidationRule>
