<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>iReady_ELA_scale_score_1400</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Assessment_Name__c = &quot;iReady - ELA&quot;,OR(Scale_Score__c &lt; 0, Scale_Score__c &gt; 1400))</errorConditionFormula>
