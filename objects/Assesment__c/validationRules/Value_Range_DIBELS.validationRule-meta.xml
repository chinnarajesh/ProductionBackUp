<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Range_DIBELS</fullName>
    <active>true</active>
    <errorConditionFormula>OR
( 
 DIBELS_Grade_Level_Equivalent_Score__c  &lt; 0, 
 DIBELS_Grade_Level_Equivalent_Score__c &gt; 1000 
 )</errorConditionFormula>
    <errorDisplayField>DIBELS_Grade_Level_Equivalent_Score__c</errorDisplayField>
    <errorMessage>DIBELS Grade Level Equivalent Score must be within a 0 - 1000 range.</errorMessage>
</ValidationRule>
