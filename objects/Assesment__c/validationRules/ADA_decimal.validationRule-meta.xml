<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ADA_decimal</fullName>
    <active>true</active>
    <errorConditionFormula>OR
(
Average_Daily_Attendance__c  &lt; 0.000,
Average_Daily_Attendance__c &gt; 1.000
)</errorConditionFormula>
    <errorDisplayField>Average_Daily_Attendance__c</errorDisplayField>
    <errorMessage>Average Daily Attendance requires values between 0.000 and 1.000</errorMessage>
</ValidationRule>
