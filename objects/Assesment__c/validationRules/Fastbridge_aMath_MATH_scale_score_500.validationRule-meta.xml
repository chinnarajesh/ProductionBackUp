<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fastbridge_aMath_MATH_scale_score_500</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Assessment_Name__c = &quot;Fastbridge_aMath_MATH&quot;, 
OR(Scale_Score__c &lt; 0, 
Scale_Score__c &gt; 500))</errorConditionFormula>
    <errorDisplayField>Scale_Score__c</errorDisplayField>
    <errorMessage>Scaled Score must be within the range of 0 to 500.</errorMessage>
</ValidationRule>
