<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Age__c</fullName>
    <externalId>false</externalId>
    <formula>IF(MONTH(TODAY())&gt;MONTH(Date_of_Birth__c),YEAR(TODAY())-YEAR(Date_of_Birth__c),IF(AND(MONTH(TODAY())=MONTH(Date_of_Birth__c),DAY(TODAY())&gt;=DAY(Date_of_Birth__c)),YEAR(TODAY())-YEAR(Date_of_Birth__c),(YEAR(TODAY())-YEAR(Date_of_Birth__c))-1))</formula>
    <inlineHelpText>Displays the student&apos;s age. SchoolForce automatically calculates this value using the student&apos;s birth date entered in the Date of Birth field. You cannot edit this field.</inlineHelpText>
    <label>Age</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
