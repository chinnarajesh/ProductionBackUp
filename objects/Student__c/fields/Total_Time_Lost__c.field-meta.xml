<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Time_Lost__c</fullName>
    <externalId>false</externalId>
    <formula>IF( Setup__r.Use_Sectional_Attendance__c  , Sectional_Attendance_Time_Lost__c , Attendance_Time_Lost__c ) +  Sum_of_Time_Lost__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Displays the student&apos;s total combined instructional time lost (in minutes), which sums the attendance and behavior time lost.</inlineHelpText>
    <label>Total Time Lost</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
