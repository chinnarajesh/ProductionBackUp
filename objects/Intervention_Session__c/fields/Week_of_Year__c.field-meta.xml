<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Week_of_Year__c</fullName>
    <description>Week of the year the intervention section occurred on</description>
    <externalId>false</externalId>
    <formula>MOD(FLOOR( (Date__c - DATEVALUE(&quot;2006-01-01&quot; ))/7),52)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Week of the year the intervention section occurred on</inlineHelpText>
    <label>WOY</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
