<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requires_Processing__c</fullName>
    <description>We can use this to ensure we don&apos;t process unnecessary records in Attendance Tracking</description>
    <externalId>false</externalId>
    <formula>IF (
AND (
ISBLANK(Text(Admin_Notifications_cons__c)),
ISBLANK(Text(Admin_Notifications_cuml__c)),
Consecutive__c +  Cumulative__c +  Minutes_Lost__c &gt; 0
),
&quot;Yes&quot;,
&quot;No&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Requires Processing?</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
