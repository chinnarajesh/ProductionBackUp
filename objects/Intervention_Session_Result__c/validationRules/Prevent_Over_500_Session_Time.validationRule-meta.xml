<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Over_500_Session_Time</fullName>
    <active>true</active>
    <errorConditionFormula>Amount_of_Time__c &gt;= 500</errorConditionFormula>
    <errorDisplayField>Amount_of_Time__c</errorDisplayField>
    <errorMessage>Session time for a day must be less than 500 minutes.</errorMessage>
</ValidationRule>
