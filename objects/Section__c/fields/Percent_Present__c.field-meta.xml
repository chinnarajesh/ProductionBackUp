<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Percent_Present__c</fullName>
    <formula>IF(Total_Attendance__c!=0, (Present_Attendance__c / Total_Attendance__c), 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Total percentage of present students in this section.  Ex: This section has an 80% present attendance rate.</inlineHelpText>
    <label>% Present</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
