<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Service_Hours</fullName>
    <active>true</active>
    <description>Service Hours Completed must be non-negative.</description>
    <errorConditionFormula>Service_Hours_Completed__c   &lt; 0</errorConditionFormula>
    <errorDisplayField>Service_Hours_Completed__c</errorDisplayField>
    <errorMessage>Service Hours Completed must non-negative.</errorMessage>
</ValidationRule>
